{
  "manifest_version": 3,
  "name": "Page Classifier",
  "version": "1.0.0",
  "description": "A brief, plain text summary of the extension's purpose.",
  "action": {
    "default_title": "Open Side Panel"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "unlimitedStorage"
  ],
   "content_scripts": [
   {
     "matches": ["<all_urls>"],
     "js": ["content.js"]
   }
 ],
  "host_permissions": [
    "<all_urls>"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}